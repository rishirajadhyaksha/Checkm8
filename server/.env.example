DEPLOYMENT_MODE=local
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
# Where the local "storage engine" persists data (Section 5 / Appendix B).
# The design doc calls for SQLite here; this implementation uses a
# dependency-free JSON-file store behind the SAME StorageAdapter interface
# (see src/db.js) so it runs anywhere with zero native build tools and can
# be swapped for real SQLite/DynamoDB later without touching game logic.
DATA_FILE=./data/checkm8-db.json
